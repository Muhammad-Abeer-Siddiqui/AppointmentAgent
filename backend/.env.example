# AI Appointment Scheduling Agent - Environment Variables
# Copy this file to .env and fill in the values

# Application
APP_NAME="AI Appointment Scheduler"
APP_VERSION="0.1.0"
DEBUG=True
ENVIRONMENT=development

# Database - Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:password@db.host.project.supabase.co:5432/postgres"

# Authentication
JWT_SECRET_KEY="your-super-secret-jwt-key-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend URL (for CORS and redirects)
FRONTEND_URL="http://localhost:3000"

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Gemini AI API Key (store server-side only!)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Security
# Never commit real credentials to version control
# Add .env to .gitignore